model Reward {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId      String       @map("family_id") @db.Uuid
  name          String       @db.VarChar(120)
  description   String?      @db.Text
  imageMediaId  String?      @map("image_media_id") @db.Uuid
  pointsCost    Int          @map("points_cost")
  type          RewardType
  stockTotal    Int?         @map("stock_total")
  stockReserved Int          @default(0) @map("stock_reserved")
  stockConsumed Int          @default(0) @map("stock_consumed")
  prerequisites Json?        @db.JsonB
  status        RewardStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(3)

