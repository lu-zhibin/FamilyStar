model Redemption {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId           String           @map("family_id") @db.Uuid
  rewardId           String           @map("reward_id") @db.Uuid
  childId            String           @map("child_id") @db.Uuid
  idempotencyKey     String           @map("idempotency_key") @db.VarChar(128)
  requestFingerprint String           @map("request_fingerprint") @db.VarChar(64)
  listedPointsCost   Int              @map("listed_points_cost")
  discount           Decimal          @default(1) @db.Decimal(5, 4)
  pointsSpent        Int              @map("points_spent")
  status             RedemptionStatus @default(PENDING)
  isAutoApproved     Boolean          @default(false) @map("is_auto_approved")
  approvedById       String?          @map("approved_by") @db.Uuid
  approvedAt         DateTime?        @map("approved_at") @db.Timestamptz(3)
  rejectedById       String?          @map("rejected_by") @db.Uuid
  rejectedAt         DateTime?        @map("rejected_at") @db.Timestamptz(3)
  rejectionReason    String?          @map("rejection_reason") @db.Text
  fulfilledById      String?          @map("fulfilled_by") @db.Uuid
  fulfilledAt        DateTime?        @map("fulfilled_at") @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  family      Family @relation(fields: [familyId], references: [id], onDelete: Restrict)
  reward      Reward @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  child       User   @relation("RedemptionChild", fields: [childId], references: [id], onDelete: Restrict)
  approvedBy  User?  @relation("RedemptionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy  User?  @relation("RedemptionRejector", fields: [rejectedById], references: [id], onDelete: SetNull)
  fulfilledBy User?  @relation("RedemptionFulfiller", fields: [fulfilledById], references: [id], onDelete: SetNull)

  @@unique([familyId, idempotencyKey])
  @@index([familyId, childId, status, createdAt])
  @@index([familyId, rewardId])
  @@index([familyId, rewardId, childId, status, createdAt])
  @@map("redemptions")
}

