model MediaAsset {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId     String            @map("family_id") @db.Uuid
  type         MediaType
  objectKey    String            @map("object_key") @db.VarChar(1024)
  mimeType     String            @map("mime_type") @db.VarChar(255)
  checksum     String            @db.VarChar(128)
  sizeBytes    BigInt            @map("size_bytes") @db.BigInt
  width        Int?
  height       Int?
  duration     Int?
  uploadStatus MediaUploadStatus @default(PENDING) @map("upload_status")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
