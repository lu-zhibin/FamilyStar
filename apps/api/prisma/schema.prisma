  @@unique([familyId, idempotencyKey])
  @@index([familyId, status, createdAt])
  @@map("media_upload_sessions")
}

model MediaUploadPart {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
