{
  "name": "@familystar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate --schema prisma/schema.prisma && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "prisma:format": "prisma format --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "start": "node dist/server.js",
    "worker:start": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "verify:api-foundation": "tsx scripts/verify-api-foundation.ts",
    "verify:data-model": "tsx scripts/verify-data-model.ts"
  },
  "dependencies": {
    "@familystar/business-modules": "workspace:*",
    "@familystar/shared": "workspace:*",
    "@hono/node-server": "2.0.12",
    "@prisma/client": "6.19.2",
    "bcryptjs": "3.0.2",
    "hono": "4.12.32",
    "redis": "6.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "prisma": "6.19.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
